# Copy to .env and adjust. .env is gitignored - never commit real secrets.

# --- server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- LLM (OpenAI-compatible endpoint) ---
# Default points at the local Ollama docker service (OpenAI-compatible /v1).
# To migrate to OpenAI later: set OPENAI_BASE_URL=https://api.openai.com/v1
# and OPENAI_API_KEY=sk-... - no code change needed.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=local-ollama
CHAT_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text

# --- vector store (optional; match falls back to keyword overlap) ---
CHROMA_URL=http://localhost:8000

# --- database (reserved; schema design comes later) ---
MONGODB_URI=mongodb://localhost:27017/resume_agent
